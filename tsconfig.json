{
  "extends": "@tsconfig/recommended/tsconfig.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "strict": true,
    "removeComments": false,
    "resolveJsonModule": true,
    "preserveConstEnums": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "rootDir": ".",
    "sourceMap": false,
    "declaration": true,
    "noEmit": true,
    "types": ["node", "jest"]
  },
  "include": [
    "lib/**/*.ts",
    "jest.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
