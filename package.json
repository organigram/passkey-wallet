      "minimatch@<3.1.4": "3.1.5",
      "minimatch@>=9.0.0 <9.0.7": "9.0.9",
      "minimatch@>=10.0.0 <10.2.3": "10.2.5",
      "path-to-regexp@>=6.0.0 <6.3.0": "6.3.0",
      "path-to-regexp@>=8.0.0 <8.4.0": "8.4.2",
      "postcss@<8.5.23": "8.5.23",
      "shell-quote@<1.11.0": "1.12.0",
      "sharp@<0.35.5": "0.35.5",
