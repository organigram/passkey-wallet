{
  "name": "@organigram/passkey-wallet-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "cert": "node scripts/generate-certs.mjs",
    "dev": "node scripts/dev-https.mjs localhost",
    "dev:proxy-target": "next dev --hostname 127.0.0.1 --port 3001",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit --incremental false"
