  "dependencies": {
    "@organigram/passkey-wallet": "file:..",
    "@rainbow-me/rainbowkit": "2.2.10",
    "@tanstack/react-query": "5.90.16",
    "next": "16.2.7",
    "next-auth": "^4.24.13",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "viem": "2.55.2",
    "wagmi": "3.7.1"
  },
  "devDependencies": {
    "@types/node": "20.19.37",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.7",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": ["@organigram/js"]
    }
  }
}
