# Optional local overrides for the Passkey Wallet Next + RainbowKit demo.
#
# The HTTPS dev script sets sane defaults automatically:
# - NEXTAUTH_URL=https://<current-demo-host>:3000
# - NEXTAUTH_SECRET=passkey-wallet-next-rainbowkit-local-demo-secret
# - PASSKEY_WALLET_RP_NAME=Passkey Wallet Example

# Label shown by the browser during WebAuthn ceremonies.
PASSKEY_WALLET_RP_NAME="Passkey Wallet Example"

# Ports used by scripts/dev-https.mjs.
PASSKEY_WALLET_DEMO_HTTPS_PORT=3000
PASSKEY_WALLET_DEMO_NEXT_PORT=3001
PASSKEY_WALLET_DEMO_LISTEN_HOST=127.0.0.1
PASSKEY_WALLET_DEMO_CERTIFICATE_NAME=local-passkey-wallet

# Override the host used by the HTTPS script.
# For example:
# PASSKEY_WALLET_DEMO_HOST=demo.local.organigram.ai

# Optional NextAuth overrides.
# NEXTAUTH_URL=https://localhost:3000
# NEXTAUTH_SECRET=replace-with-a-local-dev-secret
